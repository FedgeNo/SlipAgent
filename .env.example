# Required for OpenRouter inference: your OpenRouter API key.
OPENROUTER_API_KEY=

# Optional: default model slug used when --model is not passed.
# Run `slipagent --list-models` to browse the provider's catalog, or
# `/models free` inside the REPL to filter for models listed as free.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: enable the web_search tool (https://dashboard.exa.ai).
# fetch_page works without this.
# EXA_API_KEY=

# Optional: override the API base URL (useful for gateways or mocks).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override SlipAgent's OpenRouter app attribution.
# OPENROUTER_REFERER=https://github.com/FedgeNo/SlipAgent
# OPENROUTER_TITLE=SlipAgent
# OPENROUTER_USER_AGENT=SlipAgent/0.2.0

# Optional: default project directory when --workspace is not passed.
# SLIPAGENT_WORKSPACE=.

# Optional: set to 1 to ignore this file entirely (useful in CI).
# SLIPAGENT_NO_DOTENV=1

# Optional: select NVIDIA direct inference instead of OpenRouter.
# SLIPAGENT_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: enable Kilo Gateway's live model catalog and inference.
# KILO_API_KEY=
# KILO_MODEL=kilo-auto/free
# KILO_BASE_URL=https://api.kilo.ai/api/gateway

# Optional: enable Mistral's authenticated chat model catalog and inference.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional: enable Google's Gemini API.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
