# Required: your OpenRouter API key.
OPENROUTER_API_KEY=

# Optional: default model slug used when --model is not passed.
# Run `slipagent --list-models` to see everything available to your key, or
# `/models free` inside the REPL to see only what a $0-limit key can reach.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: enable the web_search tool (https://dashboard.exa.ai).
# fetch_page works without this.
# EXA_API_KEY=

# Optional: override the API base URL (useful for gateways or mocks).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenRouter app attribution headers.
# OPENROUTER_REFERER=https://github.com/your-org/slipagent
# OPENROUTER_TITLE=slipagent

# Optional: default project directory when --workspace is not passed.
# SLIPAGENT_WORKSPACE=.

# Optional: set to 1 to ignore this file entirely (useful in CI).
# SLIPAGENT_NO_DOTENV=1
